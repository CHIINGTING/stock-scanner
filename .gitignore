bin/
# `go build ./cmd/...` with no -o drops the binary in the repo root. 16 MB each, and
# `git add -A` would take them.
/health-dashboard
/daily-data
/valuation-backfill
.cache/
.cache_fresh_r6_5/
# R14 健檢儀表板的獨立價格快取。它與 .cache 分開是刻意的：fetcher 會回寫抓到的
# 資料，共用目錄會讓盤中的健檢把當天未收盤的半根 K 棒寫進掃描器讀的序列。
.cache-health-dashboard/
# FU-8 每日資料流程的獨立價格快取，與 .cache 分開的理由同上。
.cache-research/
*.log
.DS_Store
.claude/settings.local.json
git
# R8 ETF flow data products (keep dir structure via .gitkeep; ignore real data).
data/etf_holdings/*.json
data/etf_holdings/raw/*.csv

# 00981A official daily holdings download products (XLSX/XLS/CSV/debug png).
data/official/

# R13 SQLite research store (evidence / agent analysis / outcomes) + its WAL sidecars.
# Derived data, rebuilt from scans; the schema lives in internal/store, not in the file.
data/research/*.db
data/research/*.db-wal
data/research/*.db-shm
/stocks.yaml

# reports/ 與 docs/ 現在納入版控，但那是為了保存「無法重建」的東西：
# 新聞快照（PublishedAt≠ObservedAt 的 look-ahead 證據）、候選名單、回測摘要、SPEC。
# 渲染輸出與原始逐筆資料一律排除 —— 它們可以從 .cache 重跑，而且 git 一旦吃進
# 數百 MB 就吐不出來（要清得改寫歷史）。索引頁 index.html 是例外，GitHub Pages 需要它。
reports/report_*.html
reports/signal_validation_*.html
reports/*.csv
reports/*/

# 當沖 (day-trading) archive — 約 145 MB/2年，與 .cache 同理不進 git
data/daytrading/

# R13-M5 財報封存 —— 每日一目錄的 MOPS snapshot，是 point-in-time 歷史的來源。
# 與 data/market 同理納入版控（每檔約 1KB，累積很慢），但 tmp 檔排除。
data/fundamental/**/*.tmp
